{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores user progress, level, and learning analytics.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "level": { "type": "integer", "description": "Current learning level (1-50)" },
        "xp": { "type": "integer", "description": "Experience points" },
        "unlockedTopics": { "type": "array", "items": { "type": "string" } },
        "topicStats": { 
          "type": "object", 
          "description": "Topic ID to mastery score mapping (0-100)"
        },
        "dailyStreak": { "type": "integer" },
        "lastActive": { "type": "string", "format": "date-time" },
        "badges": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "isPro": { "type": "boolean" },
        "proUntil": { "type": "string", "format": "date-time" },
        "subscriptionId": { "type": "string" }
      },
      "required": ["uid"]
    },
    "Flashcard": {
      "title": "Flashcard",
      "description": "Spaced repetition card for a user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "front": { "type": "string" },
        "back": { "type": "string" },
        "topic": { "type": "string" },
        "easeFactor": { "type": "number", "description": "Anki-style ease factor" },
        "interval": { "type": "integer", "description": "Days until next review" },
        "nextReview": { "type": "string", "format": "date-time" },
        "consecutiveCorrect": { "type": "integer" }
      },
      "required": ["userId", "front", "back"]
    },
    "ForumTopic": {
      "title": "Forum Topic",
      "description": "A discussion topic in the community forum.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorPhoto": { "type": "string" },
        "replyCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "content", "authorId"]
    },
    "ForumReply": {
      "title": "Forum Reply",
      "description": "A reply to a forum topic.",
      "type": "object",
      "properties": {
        "topicId": { "type": "string" },
        "content": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorPhoto": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["topicId", "content", "authorId"]
    },
    "ChatMessage": {
      "title": "Chat Message",
      "description": "Stores AI chat history for the user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "model"] },
        "content": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "role", "content"]
    },
    "QuizResult": {
      "title": "Quiz Result",
      "description": "Stores results of quizzes taken by users.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "lessonId": { "type": "string" },
        "score": { "type": "number" },
        "totalQuestions": { "type": "integer" },
        "correctAnswers": { "type": "integer" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "lessonId", "score"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "A chat session between AI or users.",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["ai", "p2p"] },
        "participants": { "type": "array", "items": { "type": "string" } },
        "title": { "type": "string" },
        "lastMessage": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "participants"]
    },
    "DirectMessage": {
      "title": "Direct Message",
      "description": "An individual message within a conversation.",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "model"] },
        "content": { "type": "string" },
        "imageUrl": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "participants": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["content", "participants"]
    },
    "Feedback": {
      "title": "Feedback",
      "description": "User support or bug report feedback.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "content"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile and progress"
    },
    "/conversations/{convId}": {
      "schema": "Conversation",
      "description": "Main chat conversation document"
    },
    "/conversations/{convId}/messages/{msgId}": {
      "schema": "DirectMessage",
      "description": "Individual messages in a conversation"
    },
    "/users/{userId}/chatHistory/{messageId}": {
      "schema": "ChatMessage",
      "description": "User specific chat history with AI"
    },
    "/forumTopics/{topicId}": {
      "schema": "ForumTopic",
      "description": "Community discussion topics"
    },
    "/forumTopics/{topicId}/replies/{replyId}": {
      "schema": "ForumReply",
      "description": "Replies to a specific topic"
    },
    "/users/{userId}/quizResults/{resultId}": {
      "schema": "QuizResult",
      "description": "User specific quiz results"
    },
    "/users/{userId}/flashcards/{cardId}": {
      "schema": "Flashcard",
      "description": "User's flashcards for spaced repetition"
    },
    "/feedback/{feedbackId}": {
      "schema": "Feedback",
      "description": "User feedback or feature requests"
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ==========================================
    // 0. GLOBAL SAFETY NET
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // Connection Test
    // ==========================================
    match /test/{docId} {
      allow read: if true;
    }

    // ==========================================
    // Helper Functions (The Primitives)
    // ==========================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ==========================================
    // 1. USERS COLLECTION
    // ==========================================
    function isValidUser(data) {
      return (!('uid' in data) || data.uid == request.auth.uid) &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 256));
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId) && isValidUser(incoming());
      allow delete: if isOwner(userId);

      // Subcollections
      match /chatHistory/{msgId} {
        allow read, write: if isOwner(userId);
      }
      match /quizResults/{resId} {
        allow read, write: if isOwner(userId);
      }
      match /flashcards/{cardId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ==========================================
    // 2. CONVERSATIONS & MESSAGES
    // ==========================================
    function isValidConversation(data) {
      return data.keys().hasAll(['type', 'participants', 'updatedAt']) &&
             data.type in ['ai', 'p2p'] &&
             data.participants is list &&
             data.participants.size() >= 1 &&
             data.participants.size() <= 10 &&
             request.auth.uid in data.participants;
    }

    match /conversations/{convId} {
      allow get: if isSignedIn() && request.auth.uid in existing().participants;
      allow list: if isSignedIn() && request.auth.uid in resource.data.participants;
      
      allow create: if isSignedIn() && isValidConversation(incoming());
      
      allow update: if isSignedIn() && request.auth.uid in existing().participants;

      allow delete: if isSignedIn() && request.auth.uid in existing().participants;

      match /messages/{msgId} {
        allow read, list, get: if isSignedIn(); 
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn();
      }
    }

    // ==========================================
    // 3. FORUM TOPICS & REPLIES
    // ==========================================
    function isValidTopic(data) {
      return data.keys().hasAll(['title', 'content', 'authorId', 'authorName']) &&
             data.authorId == request.auth.uid &&
             data.title is string && data.title.size() <= 300 &&
             data.content is string && data.content.size() <= 20000;
    }

    match /forumTopics/{topicId} {
      allow read, get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidTopic(incoming());
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && existing().authorId == request.auth.uid;

      match /replies/{replyId} {
        allow read, get, list: if isSignedIn();
        allow create: if isSignedIn() && incoming().authorId == request.auth.uid;
        allow update: if isSignedIn();
        allow delete: if isSignedIn() && existing().authorId == request.auth.uid;
      }
    }

    // ==========================================
    // 4. FEEDBACK / SUPPORT
    // ==========================================
    match /feedback/{feedbackId} {
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ==========================================
    // 0. GLOBAL SAFETY NET
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // Helper Functions (The Primitives)
    // ==========================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ==========================================
    // 1. USERS COLLECTION
    // ==========================================
    function isValidUser(data) {
      // Allow optional fields like stats and isPro
      return data.keys().hasAll(['uid', 'email']) &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && isValidUser(incoming());

      // Subcollections
      match /chatHistory/{msgId} {
        allow read, write: if isOwner(userId);
      }
      match /quizResults/{resId} {
        allow read, create: if isOwner(userId);
      }
      match /flashcards/{cardId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ==========================================
    // 2. CONVERSATIONS & MESSAGES
    // ==========================================
    function isValidConversation(data) {
      return data.keys().hasAll(['type', 'participants', 'updatedAt']) &&
             data.type in ['ai', 'p2p'] &&
             data.participants is list &&
             data.participants.size() >= 1 &&
             data.participants.size() <= 10 &&
             request.auth.uid in data.participants;
    }

    match /conversations/{convId} {
      allow get: if isSignedIn() && request.auth.uid in existing().participants;
      allow list: if isSignedIn() && request.auth.uid in resource.data.participants;
      
      allow create: if isSignedIn() && isValidConversation(incoming()) && 
                    incoming().createdAt == request.time;
      
      allow update: if isSignedIn() && request.auth.uid in existing().participants &&
                    isValidConversation(incoming()) &&
                    incoming().updatedAt == request.time &&
                    incoming().diff(existing()).affectedKeys().hasAny(['lastMessage', 'updatedAt', 'title']);

      match /messages/{msgId} {
        // Use a simpler check for list/read to avoid get() costs where possible
        allow read, list: if isSignedIn(); 
        allow create: if isSignedIn() && 
                      incoming().timestamp == request.time;
      }
    }

    // ==========================================
    // 3. FORUM TOPICS & REPLIES
    // ==========================================
    function isValidTopic(data) {
      return data.keys().hasAll(['title', 'content', 'authorId', 'authorName']) &&
             data.authorId == request.auth.uid &&
             data.title is string && data.title.size() <= 300 &&
             data.content is string && data.content.size() <= 20000;
    }

    match /forumTopics/{topicId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidTopic(incoming()) && 
                    incoming().createdAt == request.time;
      allow update: if isSignedIn() && (
        // Author update
        (existing().authorId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasAny(['title', 'content', 'updatedAt', 'isPromoted'])) ||
        // Anyone can update replyCount or reactions
        (incoming().diff(existing()).affectedKeys().hasAny(['replyCount', 'reactions']))
      );
      allow delete: if isSignedIn() && existing().authorId == request.auth.uid;

      match /replies/{replyId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && 
                      incoming().authorId == request.auth.uid &&
                      incoming().content is string && incoming().content.size() <= 10000 &&
                      incoming().createdAt == request.time;
        allow update: if isSignedIn() && (
          (existing().authorId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasAny(['content', 'updatedAt'])) ||
          (incoming().diff(existing()).affectedKeys().hasAny(['reactions']))
        );
        allow delete: if isSignedIn() && existing().authorId == request.auth.uid;
      }
    }
  }
}
